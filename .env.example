# Copy to .env for local development. Names only — never commit values.
#
# This file covers the Next.js / Vercel side only. Everything the booking
# and comms rails actually run on lives in SUPABASE EDGE FUNCTION SECRETS
# (Supabase dashboard → Edge Functions → Secrets), which the browser must
# never see. See docs/CREDENTIALS.md for that list.

# ─── Public (inlined into the browser bundle — safe to expose) ─────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Override the canonical origins used for cross-host redirects. Defaults
# are admin.alphaluxcleaning.com and try.alphaluxcleaning.com.
NEXT_PUBLIC_ADMIN_ORIGIN=
NEXT_PUBLIC_BOOKING_ORIGIN=

NEXT_PUBLIC_ZAPIER_WEBHOOK_URL=

# ─── Server-side on Vercel (NOT exposed to the browser) ────────────────
# Used only by app/api/create-job/route.ts. Note this is a SEPARATE store
# from Supabase secrets: setting HCP_API_KEY in one does not set it in the
# other, and both need the real value.
HCP_API_KEY=
